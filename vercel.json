{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/ice.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,node_modules/**,fixtures/**,bench/**,test/**}"
    }
  }
}